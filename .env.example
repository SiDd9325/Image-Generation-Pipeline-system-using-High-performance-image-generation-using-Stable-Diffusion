# ==============================================================================
# GenStudio AI - Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
APP_NAME=GenStudio AI
APP_VERSION=1.0.0
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars-long!

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Database Configuration (PostgreSQL in Docker/Prod, SQLite supported for zero-setup dev & tests)
DATABASE_URL=postgresql://genstudio:genstudio_secret@localhost:5432/genstudio_db
# Test / Standalone Fallback:
# DATABASE_URL=sqlite:///./genstudio.db

# Redis Configuration (Job Queue & Cache)
REDIS_URL=redis://localhost:6379/0
REDIS_QUEUE_NAME=genstudio:jobs

# Storage Configuration
# STORAGE_BACKEND options: "local" | "s3"
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage/artifacts

# S3 / MinIO Configuration (Required if STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
S3_BUCKET_NAME=genstudio-artifacts
S3_ENDPOINT_URL=http://localhost:9000
S3_USE_SSL=false

# Inference Provider Configuration
# Options: "demo" (zero-GPU procedural canvas) | "stable_diffusion" (KerasCV / PyTorch diffusers)
INFERENCE_PROVIDER=demo
MODEL_ID=stabilityai/stable-diffusion-2-1-base
DEVICE=cpu
DEFAULT_IMAGE_WIDTH=512
DEFAULT_IMAGE_HEIGHT=512
DEFAULT_STEPS=25
MAX_STEPS=100

# Rate Limiting & Safety
RATE_LIMIT_PER_MINUTE=60
MAX_CONCURRENT_JOBS_PER_CLIENT=3

# Observability
PROMETHEUS_METRICS_ENABLED=true
METRICS_PORT=8000
